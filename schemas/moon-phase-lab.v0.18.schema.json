{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/moon-phase-lab.v0.18.schema.json",
  "title": "月相位置与可见时段实验数据 v0.18",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "topic_id", "title", "review_after_hours", "model_note", "phases", "scenarios", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.18.0" }, "id": { "const": "moon-phase-lab" }, "topic_id": { "type": "string" }, "title": { "type": "string" }, "review_after_hours": { "type": "integer", "minimum": 48 }, "model_note": { "type": "string" },
    "phases": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/phase" } },
    "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/scenario" } },
    "error_tags": { "type": "object", "minProperties": 5, "additionalProperties": { "type": "string" } },
    "sources": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url", "supports"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "supports": { "type": "string" } } } }
  },
  "$defs": {
    "phase": { "type": "object", "additionalProperties": false, "required": ["id", "name", "angle_deg", "lunar_date", "illumination", "illumination_percent", "trend", "rise", "transit", "set", "observation", "category"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "angle_deg": { "type": "integer", "minimum": 0, "maximum": 315, "multipleOf": 45 }, "lunar_date": { "type": "string" }, "illumination": { "type": "string" }, "illumination_percent": { "type": "integer", "minimum": 0, "maximum": 100 }, "trend": { "type": "string" }, "rise": { "type": "string" }, "transit": { "type": "string" }, "set": { "type": "string" }, "observation": { "type": "string" }, "category": { "enum": ["waxing", "waning", "transition"] } } },
    "answers": { "type": "object", "additionalProperties": false, "required": ["phase", "illumination", "trend", "transit", "conclusion"], "properties": { "phase": { "type": "string" }, "illumination": { "type": "string" }, "trend": { "type": "string" }, "transit": { "type": "string" }, "conclusion": { "type": "string" } } },
    "choiceArray": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "choices": { "type": "object", "additionalProperties": false, "required": ["phase", "illumination", "trend", "transit", "conclusion"], "properties": { "phase": { "$ref": "#/$defs/choiceArray" }, "illumination": { "$ref": "#/$defs/choiceArray" }, "trend": { "$ref": "#/$defs/choiceArray" }, "transit": { "$ref": "#/$defs/choiceArray" }, "conclusion": { "$ref": "#/$defs/choiceArray" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "phase_id", "challenge", "observations", "choices", "answers"], "properties": { "id": { "type": "string", "pattern": "^MP-[0-9]{2}$" }, "phase_id": { "type": "string" }, "challenge": { "type": "string" }, "observations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "choices": { "$ref": "#/$defs/choices" }, "answers": { "$ref": "#/$defs/answers" } } }
  }
}
