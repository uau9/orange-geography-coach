{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange-geography-coach/attempt.v0.1",
  "type": "object",
  "required": ["id", "question_id", "selected_option", "reasoning", "confidence", "submitted_at", "parent_review_status"],
  "properties": {
    "id": {"type": "string"},
    "question_id": {"type": "string"},
    "selected_option": {"type": "string"},
    "reasoning": {"type": "string"},
    "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
    "is_correct": {"type": "boolean"},
    "error_tag_candidate": {"type": "string"},
    "ai_response": {"type": "string"},
    "parent_review_status": {"enum": ["待家长确认", "已确认", "需再看", "需教师复核"]},
    "parent_note": {"type": "string"},
    "submitted_at": {"type": "string"}
  }
}
