{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/annual-sun-lab.v0.9.schema.json",
  "title": "太阳直射点周年回归实验内容 v0.9",
  "type": "object",
  "required": ["schema_version", "topic_id", "title", "description", "model_note", "review_after_hours", "checkpoints", "places", "choices", "error_tags"],
  "properties": {
    "schema_version": { "const": "0.9.0" },
    "topic_id": { "const": "physical.earth.motion" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "model_note": { "type": "string", "minLength": 1 },
    "review_after_hours": { "type": "integer", "minimum": 24 },
    "checkpoints": { "type": "array", "minItems": 8, "maxItems": 8 },
    "places": { "type": "array", "minItems": 2 },
    "choices": { "type": "object" },
    "error_tags": { "type": "object" }
  }
}
