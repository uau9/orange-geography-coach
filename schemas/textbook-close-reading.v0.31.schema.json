{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange-geography-coach/textbook-close-reading.v0.31.0",
  "title": "教材逐页精读 v0.31.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "book",
    "chapter",
    "section",
    "status",
    "textbook_image_base",
    "page_start",
    "page_end",
    "chapter_map",
    "method",
    "pages",
    "question_groups",
    "parent_checklist"
  ],
  "properties": {
    "schema_version": {
      "const": "0.31.0"
    },
    "id": {
      "const": "selective-1-ch02-s01-close-reading"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "status": {
      "const": "published"
    },
    "textbook_image_base": {
      "const": "./assets/textbook/selective-1-ch02-s01"
    },
    "page_start": {
      "const": 18
    },
    "page_end": {
      "const": 25
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "student_steps",
        "completion_rule"
      ],
      "properties": {
        "student_steps": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "completion_rule": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "pdf_page",
          "title",
          "focus",
          "image",
          "read_targets",
          "image_reading",
          "analysis",
          "extensions",
          "transfer",
          "summary",
          "check_question_id"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 18,
            "maximum": 25
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 23,
            "maximum": 30
          },
          "title": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "pattern": "^page-(18|19|20|21|22|23|24|25)\\.jpg$"
          },
          "read_targets": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "image_reading": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "figure",
                "observe",
                "interpret",
                "exam_link"
              ],
              "properties": {
                "figure": {
                  "type": "string"
                },
                "observe": {
                  "type": "string"
                },
                "interpret": {
                  "type": "string"
                },
                "exam_link": {
                  "type": "string"
                }
              }
            }
          },
          "analysis": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string"
            }
          },
          "extensions": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            }
          },
          "transfer": {
            "type": "string"
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "core",
              "chain",
              "terms",
              "pitfall"
            ],
            "properties": {
              "core": {
                "type": "string"
              },
              "chain": {
                "type": "string"
              },
              "terms": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "string"
                }
              },
              "pitfall": {
                "type": "string"
              }
            }
          },
          "check_question_id": {
            "type": "string",
            "pattern": "^GEO-GEO-0(05|06|07|08|09|10|11|12)$"
          }
        }
      }
    },
    "question_groups": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "title",
          "purpose",
          "unlock",
          "question_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "question_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "unlock": {
            "enum": [
              "always",
              "section_complete"
            ]
          }
        }
      }
    },
    "parent_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "chapter_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guiding_question",
        "sections",
        "research"
      ],
      "properties": {
        "guiding_question": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "title",
              "role",
              "status"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "title": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "active",
                  "planned"
                ]
              }
            }
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "role"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
