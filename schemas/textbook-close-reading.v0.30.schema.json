{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange-geography-coach/textbook-close-reading.v0.30",
  "title": "教材逐页精读 v0.30",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "book", "chapter", "section", "status", "textbook_image_base", "page_start", "page_end", "method", "pages", "question_groups", "parent_checklist"],
  "properties": {
    "schema_version": {"const": "0.30.0"},
    "id": {"const": "selective-1-ch02-s01-close-reading"},
    "book": {"type": "string"},
    "chapter": {"type": "string"},
    "section": {"type": "string"},
    "status": {"const": "published"},
    "textbook_image_base": {"const": "./assets/textbook/selective-1-ch02-s01"},
    "page_start": {"const": 18},
    "page_end": {"const": 25},
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["student_steps", "completion_rule"],
      "properties": {"student_steps": {"type": "array", "minItems": 4, "items": {"type": "string"}}, "completion_rule": {"type": "string"}}
    },
    "pages": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["page", "pdf_page", "title", "focus", "image", "read_targets", "analysis", "extensions", "transfer"],
        "properties": {
          "page": {"type": "integer", "minimum": 18, "maximum": 25},
          "pdf_page": {"type": "integer", "minimum": 23, "maximum": 30},
          "title": {"type": "string"}, "focus": {"type": "string"},
          "image": {"type": "string", "pattern": "^page-(18|19|20|21|22|23|24|25)\\.jpg$"},
          "read_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "analysis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "extensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "transfer": {"type": "string"}
        }
      }
    },
    "question_groups": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "title", "purpose", "question_ids"],
        "properties": {
          "id": {"type": "string"}, "label": {"type": "string"}, "title": {"type": "string"}, "purpose": {"type": "string"},
          "question_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "parent_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
