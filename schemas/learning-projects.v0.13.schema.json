{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/learning-projects.v0.13.schema.json",
  "title": "橙子地理教练学习项目清单 v0.13",
  "type": "object",
  "required": ["schema_version", "projects"],
  "properties": { "schema_version": { "const": "0.13.0" }, "projects": { "type": "array", "minItems": 11, "items": {
    "type": "object", "additionalProperties": false, "required": ["id", "eyebrow", "title", "summary", "action", "route", "cta", "status_kind", "accent", "order"],
    "properties": {
      "id": { "type": "string" }, "eyebrow": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" },
      "action": { "enum": ["start-earth-motion", "start-solar-season", "start-annual-sun", "start-orbit-speed", "start-terminator-link", "start-rotation-speed", "start-date-range", "start-solar-path", "start-time-lab", "start-next", "goto"] },
      "route": { "type": ["string", "null"] }, "cta": { "type": "string" },
      "status_kind": { "enum": ["earth_motion", "solar_season", "annual_sun", "orbit_speed", "terminator_link", "rotation_speed", "date_range", "solar_path", "time_lab", "diagnostic", "retest"] },
      "accent": { "enum": ["navy", "gold", "violet", "emerald", "coral", "cyan", "indigo", "sky", "teal", "orange", "slate"] },
      "order": { "type": "integer", "minimum": 0 }
    }
  } } }
}
