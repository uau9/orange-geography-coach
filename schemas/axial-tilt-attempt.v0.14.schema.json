{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/axial-tilt-attempt.v0.14.schema.json",
  "title": "黄赤交角与五带实验记录 v0.14",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "scenario_id", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": { "const": "0.14.0" }, "id": { "type": "string", "minLength": 1 }, "scenario_id": { "type": "string", "pattern": "^AT-[0-9]{2}$" },
    "answers": { "type": "object", "additionalProperties": false, "required": ["tropic_latitude", "polar_circle_latitude", "tropical_width", "temperate_width_each", "zone_change"], "properties": {
      "tropic_latitude": { "type": "number", "minimum": 0, "maximum": 45 }, "polar_circle_latitude": { "type": "number", "minimum": 45, "maximum": 90 },
      "tropical_width": { "type": "number", "minimum": 0, "maximum": 90 }, "temperate_width_each": { "type": "number", "minimum": 0, "maximum": 90 }, "zone_change": { "type": "string" }
    } },
    "correct_answers": { "type": "object" }, "checks": { "type": "object" }, "score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "error_tags": { "type": "array", "items": { "type": "string" } }, "reasoning": { "type": "string", "minLength": 1 }, "submitted_at": { "type": "string", "format": "date-time" },
    "parent_review_status": { "enum": ["待家长确认", "已确认", "需再练", "需教师复核"] }, "parent_note": { "type": "string" }
  }
}
