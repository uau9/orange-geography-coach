{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/habitability-lab.v0.16.schema.json",
  "title": "地球宜居条件对照实验数据 v0.16",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "topic_id", "title", "review_after_hours", "model_note", "bodies", "scenarios", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.16.0" },
    "id": { "const": "habitability-lab" },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "review_after_hours": { "type": "integer", "minimum": 24 },
    "model_note": { "type": "string", "minLength": 1 },
    "bodies": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/body" } },
    "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/scenario" } },
    "error_tags": { "type": "object", "minProperties": 5, "additionalProperties": { "type": "string" } },
    "sources": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url", "supports"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "supports": { "type": "string" } } } }
  },
  "$defs": {
    "body": { "type": "object", "additionalProperties": false, "required": ["id", "name", "color", "distance_au", "solar_flux_percent", "pressure_label", "pressure_ratio", "atmosphere", "temperature", "surface_water", "evidence_note"], "properties": {
      "id": { "enum": ["venus", "earth", "mars", "moon"] }, "name": { "type": "string" }, "color": { "type": "string" }, "distance_au": { "type": "number", "minimum": 0.1 }, "solar_flux_percent": { "type": "number", "minimum": 0 }, "pressure_label": { "type": "string" }, "pressure_ratio": { "type": "number", "minimum": 0 }, "atmosphere": { "type": "string" }, "temperature": { "type": "string" }, "surface_water": { "type": "string" }, "evidence_note": { "type": "string" }
    } },
    "answers": { "type": "object", "additionalProperties": false, "required": ["higher_solar", "higher_pressure", "temperature_window", "stable_liquid_water", "best_inference"], "properties": { "higher_solar": { "type": "string" }, "higher_pressure": { "type": "string" }, "temperature_window": { "type": "string" }, "stable_liquid_water": { "type": "string" }, "best_inference": { "type": "string" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "body_a", "body_b", "pair_category", "challenge", "inference_choices", "answers"], "properties": {
      "id": { "type": "string", "pattern": "^HB-[0-9]{2}$" }, "body_a": { "enum": ["venus", "earth", "mars", "moon"] }, "body_b": { "enum": ["venus", "earth", "mars", "moon"] }, "pair_category": { "enum": ["same_solar", "different_solar"] }, "challenge": { "type": "string" }, "inference_choices": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } }, "answers": { "$ref": "#/$defs/answers" }
    } }
  }
}
