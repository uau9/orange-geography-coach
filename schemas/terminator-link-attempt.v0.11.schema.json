{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/terminator-link-attempt.v0.11.schema.json",
  "title": "晨昏线综合联动实验记录 v0.11",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "scenario_id", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": { "const": "0.11.0" },
    "id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "pattern": "^TL-[0-9]{2}$" },
    "answers": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_longitude", "local_time", "day_length_hours", "status", "polar_pattern"],
      "properties": {
        "direct_longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "local_time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "day_length_hours": { "type": "number", "minimum": 0, "maximum": 24 },
        "status": { "enum": ["白昼区", "黑夜区", "晨线", "昏线"] },
        "polar_pattern": { "type": "string", "minLength": 1 }
      }
    },
    "correct_answers": { "type": "object" },
    "checks": { "type": "object" },
    "score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "error_tags": { "type": "array", "items": { "type": "string" } },
    "reasoning": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "parent_review_status": { "enum": ["待家长确认", "已确认", "需再练", "需教师复核"] },
    "parent_note": { "type": "string" }
  }
}
