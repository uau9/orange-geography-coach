{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://uau9.github.io/orange-geography-coach/schemas/tide-lab.v0.20.schema.json", "title": "潮汐周期与月相实验数据 v0.20", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "topic_id", "title", "review_after_hours", "model_note", "cases", "scenarios", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.20.0" }, "id": { "const": "tide-lab" }, "topic_id": { "type": "string" }, "title": { "type": "string" }, "review_after_hours": { "type": "integer", "minimum": 48 }, "model_note": { "type": "string" },
    "cases": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/case" } }, "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/scenario" } },
    "error_tags": { "type": "object", "minProperties": 5, "additionalProperties": { "type": "string" } }, "sources": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url", "supports"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "supports": { "type": "string" } } } }
  },
  "$defs": {
    "case": { "type": "object", "additionalProperties": false, "required": ["id", "name", "phase", "angle_deg", "geometry", "tide_type", "range", "trend", "category"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "phase": { "type": "string" }, "angle_deg": { "type": "number", "minimum": 0, "maximum": 360 }, "geometry": { "type": "string" }, "tide_type": { "type": "string" }, "range": { "type": "string" }, "trend": { "type": "string" }, "category": { "enum": ["spring", "neap", "transition"] } } },
    "answers": { "type": "object", "additionalProperties": false, "required": ["geometry", "tide_type", "range", "cycle", "conclusion"], "properties": { "geometry": { "type": "string" }, "tide_type": { "type": "string" }, "range": { "type": "string" }, "cycle": { "type": "string" }, "conclusion": { "type": "string" } } },
    "choiceArray": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "choices": { "type": "object", "additionalProperties": false, "required": ["geometry", "tide_type", "range", "cycle", "conclusion"], "properties": { "geometry": { "$ref": "#/$defs/choiceArray" }, "tide_type": { "$ref": "#/$defs/choiceArray" }, "range": { "$ref": "#/$defs/choiceArray" }, "cycle": { "$ref": "#/$defs/choiceArray" }, "conclusion": { "$ref": "#/$defs/choiceArray" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "case_id", "challenge", "observations", "choices", "answers"], "properties": { "id": { "type": "string", "pattern": "^TD-[0-9]{2}$" }, "case_id": { "type": "string" }, "challenge": { "type": "string" }, "observations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "choices": { "$ref": "#/$defs/choices" }, "answers": { "$ref": "#/$defs/answers" } } }
  }
}
