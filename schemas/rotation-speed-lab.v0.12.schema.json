{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/rotation-speed-lab.v0.12.schema.json",
  "title": "地球自转速度实验数据 v0.12",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_id", "title", "description", "model_note", "review_after_hours", "facts", "places", "scenarios", "choices", "error_tags"],
  "properties": {
    "schema_version": { "const": "0.12.0" }, "topic_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 }, "model_note": { "type": "string", "minLength": 1 }, "review_after_hours": { "type": "integer", "minimum": 24 },
    "facts": { "type": "object", "additionalProperties": false, "required": ["rotation_hours", "angular_speed_deg_h", "equator_circumference_km", "equator_speed_km_h"], "properties": {
      "rotation_hours": { "const": 24 }, "angular_speed_deg_h": { "const": 15 }, "equator_circumference_km": { "type": "number", "minimum": 40000, "maximum": 40100 }, "equator_speed_km_h": { "type": "number", "minimum": 1660, "maximum": 1680 }
    } },
    "places": { "type": "array", "minItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "latitude", "longitude", "band"], "properties": {
      "id": { "type": "string" }, "name": { "type": "string" }, "latitude": { "type": "number", "minimum": -89, "maximum": 89 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 }, "band": { "enum": ["low", "mid", "high"] }
    } } },
    "scenarios": { "type": "array", "minItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "place_id", "duration_hours"], "properties": {
      "id": { "type": "string", "pattern": "^RS-[0-9]{2}$" }, "place_id": { "type": "string" }, "duration_hours": { "type": "integer", "minimum": 1, "maximum": 12 }
    } } },
    "choices": { "type": "object", "required": ["angular_speed", "line_speed_relation"] }, "error_tags": { "type": "object", "minProperties": 5 }
  }
}
