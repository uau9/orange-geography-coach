{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/solar-path-lab.v0.8.schema.json",
  "title": "日出日落与太阳视运动实验内容 v0.8",
  "type": "object",
  "required": ["schema_version", "topic_id", "title", "description", "model_note", "review_after_hours", "dates", "places", "choices", "error_tags"],
  "properties": {
    "schema_version": { "const": "0.8.0" },
    "topic_id": { "const": "physical.earth.motion" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "model_note": { "type": "string", "minLength": 1 },
    "review_after_hours": { "type": "integer", "minimum": 24 },
    "dates": { "type": "array", "minItems": 4, "maxItems": 4 },
    "places": { "type": "array", "minItems": 4 },
    "choices": { "type": "object" },
    "error_tags": { "type": "object" }
  }
}
