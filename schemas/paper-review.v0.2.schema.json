{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange-geography-coach/paper-review.v0.2",
  "type": "object",
  "required": ["schema_version", "id", "title", "source_note", "scores", "reviewed_question"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "id": {"type": "string", "pattern": "^PAPER-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 4},
    "source_note": {"type": "string", "minLength": 10},
    "scores": {
      "type": "object",
      "required": ["raw", "standard"],
      "properties": {
        "raw": {
          "type": "object",
          "required": ["earned", "max", "objective", "subjective"]
        },
        "standard": {
          "type": "object",
          "required": ["earned", "scale_note"]
        }
      }
    },
    "reviewed_question": {
      "type": "object",
      "required": ["id", "earned_points", "max_points", "diagnosis_status", "subquestions"],
      "properties": {
        "diagnosis_status": {"enum": ["候选", "已确认"]},
        "subquestions": {"type": "array", "minItems": 1}
      }
    }
  }
}
