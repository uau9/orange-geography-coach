{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://uau9.github.io/orange-geography-coach/schemas/eclipse-lab.v0.19.schema.json", "title": "日月食几何与可见范围实验数据 v0.19", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "topic_id", "title", "review_after_hours", "model_note", "cases", "scenarios", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.19.0" }, "id": { "const": "eclipse-lab" }, "topic_id": { "type": "string" }, "title": { "type": "string" }, "review_after_hours": { "type": "integer", "minimum": 48 }, "model_note": { "type": "string" },
    "cases": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/case" } }, "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/scenario" } },
    "error_tags": { "type": "object", "minProperties": 5, "additionalProperties": { "type": "string" } }, "sources": { "type": "array", "minItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url", "supports"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "supports": { "type": "string" } } } }
  },
  "$defs": {
    "case": { "type": "object", "additionalProperties": false, "required": ["id", "name", "family", "phase", "alignment", "shadow", "phenomenon", "visibility", "category", "diagram_mode", "offset", "moon_scale"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "family": { "enum": ["solar", "lunar"] }, "phase": { "enum": ["新月", "满月"] }, "alignment": { "type": "string" }, "shadow": { "type": "string" }, "phenomenon": { "type": "string" }, "visibility": { "type": "string" }, "category": { "type": "string" }, "diagram_mode": { "enum": ["solar", "lunar"] }, "offset": { "type": "number" }, "moon_scale": { "type": "number", "exclusiveMinimum": 0 } } },
    "answers": { "type": "object", "additionalProperties": false, "required": ["alignment", "shadow", "phenomenon", "visibility", "conclusion"], "properties": { "alignment": { "type": "string" }, "shadow": { "type": "string" }, "phenomenon": { "type": "string" }, "visibility": { "type": "string" }, "conclusion": { "type": "string" } } },
    "choiceArray": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "choices": { "type": "object", "additionalProperties": false, "required": ["alignment", "shadow", "phenomenon", "visibility", "conclusion"], "properties": { "alignment": { "$ref": "#/$defs/choiceArray" }, "shadow": { "$ref": "#/$defs/choiceArray" }, "phenomenon": { "$ref": "#/$defs/choiceArray" }, "visibility": { "$ref": "#/$defs/choiceArray" }, "conclusion": { "$ref": "#/$defs/choiceArray" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "case_id", "challenge", "observations", "choices", "answers"], "properties": { "id": { "type": "string", "pattern": "^EC-[0-9]{2}$" }, "case_id": { "type": "string" }, "challenge": { "type": "string" }, "observations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "choices": { "$ref": "#/$defs/choices" }, "answers": { "$ref": "#/$defs/answers" } } }
  }
}
