{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://uau9.github.io/orange-geography-coach/schemas/eclipse-attempt.v0.19.schema.json", "title": "日月食几何与可见范围实验记录 v0.19", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "scenario_id", "case_id", "family", "category", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": { "const": "0.19.0" }, "id": { "type": "string" }, "scenario_id": { "type": "string", "pattern": "^EC-[0-9]{2}$" }, "case_id": { "type": "string" }, "family": { "enum": ["solar", "lunar"] }, "category": { "type": "string" },
    "answers": { "$ref": "#/$defs/answers" }, "correct_answers": { "$ref": "#/$defs/answers" }, "checks": { "type": "object", "additionalProperties": false, "required": ["alignment", "shadow", "phenomenon", "visibility", "conclusion"], "properties": { "alignment": { "type": "boolean" }, "shadow": { "type": "boolean" }, "phenomenon": { "type": "boolean" }, "visibility": { "type": "boolean" }, "conclusion": { "type": "boolean" } } },
    "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "error_tags": { "type": "array", "items": { "type": "string" } }, "reasoning": { "type": "string", "minLength": 1 }, "submitted_at": { "type": "string", "format": "date-time" }, "parent_review_status": { "enum": ["待家长确认", "已确认", "需再练", "需教师复核"] }, "parent_note": { "type": "string" }
  },
  "$defs": { "answers": { "type": "object", "additionalProperties": false, "required": ["alignment", "shadow", "phenomenon", "visibility", "conclusion"], "properties": { "alignment": { "type": "string" }, "shadow": { "type": "string" }, "phenomenon": { "type": "string" }, "visibility": { "type": "string" }, "conclusion": { "type": "string" } } } }
}
