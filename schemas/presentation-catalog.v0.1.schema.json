{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange-geography-coach.local/schemas/presentation-catalog.v0.1.schema.json",
  "title": "橙子地理教练 PPT 目录 v0.1",
  "type": "object",
  "required": ["schema_version", "updated_at", "chapter_id", "chapter_title", "decks"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "updated_at": { "type": "string", "format": "date-time" },
    "chapter_id": { "type": "string", "minLength": 1 },
    "chapter_title": { "type": "string", "minLength": 1 },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "title", "path", "slide_count", "lab_ids", "question_ids", "slides"],
        "properties": {
          "id": { "type": "string", "pattern": "^ppt-" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "\\.pptx$" },
          "slide_count": { "type": "integer", "minimum": 1 },
          "lab_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "question_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": { "type": "string", "pattern": "^ppt-eu\\d{2}-s\\d{2}$" },
                "kind": { "type": "string", "minLength": 1 },
                "lab_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "question_id": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
