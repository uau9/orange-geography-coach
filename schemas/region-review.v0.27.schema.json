{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange-geography-coach/region-review.v0.27",
  "title": "选择性必修2区域发展14天复习 v0.27",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "subtitle", "student", "local_only", "source_note", "textbook", "reasoning_steps", "days", "delayed_retest_ids", "parent_checklist"],
  "properties": {
    "schema_version": {"const": "0.27.0"},
    "id": {"const": "region-development-review"},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "student": {"type": "string"},
    "local_only": {"const": false},
    "source_note": {"type": "string"},
    "textbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "path"],
      "properties": {"title": {"type": "string"}, "path": {"type": "string"}}
    },
    "reasoning_steps": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "label", "prompt"],
        "properties": {"order": {"type": "integer", "minimum": 1}, "label": {"type": "string"}, "prompt": {"type": "string"}}
      }
    },
    "days": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "knowledge_point_id", "title", "goal", "textbook_pages", "pdf_pages", "textbook_href", "reading_prompts", "question_ids", "source_label"],
        "properties": {
          "day": {"type": "integer", "minimum": 1, "maximum": 14},
          "knowledge_point_id": {"type": "string", "minLength": 3},
          "title": {"type": "string"},
          "goal": {"type": "string"},
          "textbook_pages": {"type": "string"},
          "pdf_pages": {"type": "string"},
          "textbook_href": {"type": "string"},
          "reading_prompts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "question_ids": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string"}, "uniqueItems": true},
          "source_label": {"type": "string"}
        }
      }
    },
    "delayed_retest_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "parent_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
