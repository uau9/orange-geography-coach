{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/learning-export.v0.24.0.schema.json",
  "title": "橙子地理教练可批注学习档案 v0.24.0",
  "type": "object",
  "required": ["version", "export_schema_version", "export_id", "exported_at", "summary", "attempts", "atmosphere_reasoning_attempts", "coach_annotations", "annotation_guide"],
  "properties": {
    "version": {"enum": ["0.1.0", "0.2.0", "0.3.0"]},
    "export_schema_version": {"const": "0.24.0"},
    "app_version": {"const": "0.24.0"},
    "export_id": {"type": "string", "pattern": "^EXPORT-"},
    "exported_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "object", "required": ["total_learning_records", "pending_parent_reviews", "activity_window", "by_project", "by_topic", "candidate_error_tags", "atmosphere_reasoning_attempts"], "properties": {"total_learning_records": {"type": "integer"}, "pending_parent_reviews": {"type": "integer"}, "activity_window": {"type": "object"}, "by_project": {"type": "array", "minItems": 23}, "by_topic": {"type": "array"}, "candidate_error_tags": {"type": "array"}, "atmosphere_reasoning_attempts": {"type": "integer"}}},
    "attempts": {"type": "array"},
    "atmosphere_reasoning_attempts": {"type": "array"},
    "coach_annotations": {"type": "array"},
    "annotation_guide": {"type": "object"}
  }
}
