{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange-geography-coach.local/schemas/pocket-recall.v1.schema.json",
  "title": "口袋书结构化背诵样板",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "source", "overview", "sections", "audit"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"const": "pocket-population"},
    "title": {"type": "string"},
    "overview": {"$ref": "#/$defs/block"},
    "status": {"const": "published"},
    "source": {"type": "object", "required": ["file", "sha256", "included", "excluded"], "properties": {"file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "included": {"type": "array", "items": {"type": "string"}}, "excluded": {"type": "array", "items": {"type": "string"}}}},
    "sections": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "required": ["id", "group", "title", "source_blocks", "blocks"], "properties": {"id": {"type": "string", "pattern": "^pocket11-[0-9]{2}$"}, "group": {"enum": ["知识清单", "易错易混", "知能拓展"]}, "title": {"type": "string"}, "source_blocks": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}}}},
    "audit": {"type": "object", "required": ["references", "corrections", "blank_count", "images_sha256"], "properties": {"references": {"type": "array"}, "corrections": {"type": "array"}, "blank_count": {"type": "integer", "minimum": 1}, "images_sha256": {"type": "object"}}}
  },
  "$defs": {
    "blank": {"type": "object", "required": ["type", "id", "answer", "origin"], "properties": {"type": {"const": "blank"}, "id": {"type": "string"}, "answer": {"type": "string", "minLength": 1}, "origin": {"enum": ["source-marking", "reviewed-addition", "reviewed-image-mask"]}}},
    "token": {"oneOf": [{"$ref": "#/$defs/blank"}, {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string"}}}]},
    "mask": {"allOf": [{"$ref": "#/$defs/blank"}, {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}]},
    "block": {"oneOf": [
      {"type": "object", "required": ["type", "source_block", "tokens", "source_text"], "properties": {"type": {"enum": ["heading", "paragraph"]}, "source_block": {"type": "integer"}, "source_text": {"type": "string"}, "tokens": {"type": "array", "items": {"$ref": "#/$defs/token"}}}},
      {"type": "object", "required": ["type", "source_block", "rows", "columns"], "properties": {"type": {"const": "table"}, "source_block": {"type": "integer"}, "columns": {"type": "integer", "minimum": 1}, "note": {"type": "string"}, "rows": {"type": "array", "items": {"type": "array", "items": {"type": "object", "required": ["column", "colspan", "rowspan", "blocks"], "properties": {"column": {"type": "integer", "minimum": 0}, "colspan": {"type": "integer", "minimum": 1}, "rowspan": {"type": "integer", "minimum": 1}, "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}}}}}}},
      {"type": "object", "required": ["type", "source_block", "image", "width", "height", "caption", "masks"], "properties": {"type": {"const": "figure"}, "source_block": {"type": "integer"}, "image": {"type": "string", "pattern": "^assets/recall/pocket-population/"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "caption": {"type": "string"}, "masks": {"type": "array", "items": {"$ref": "#/$defs/mask"}}}}
    ]}
  }
}
