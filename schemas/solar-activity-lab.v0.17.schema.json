{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/solar-activity-lab.v0.17.schema.json",
  "title": "太阳活动证据判读实验数据 v0.17",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "topic_id", "title", "review_after_hours", "model_note", "paths", "scenarios", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.17.0" }, "id": { "const": "solar-activity-lab" }, "topic_id": { "type": "string" }, "title": { "type": "string" }, "review_after_hours": { "type": "integer", "minimum": 24 }, "model_note": { "type": "string" },
    "paths": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "time", "color", "note"], "properties": { "id": { "enum": ["radiation", "particles", "plasma"] }, "name": { "type": "string" }, "time": { "type": "string" }, "color": { "type": "string" }, "note": { "type": "string" } } } },
    "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/scenario" } },
    "error_tags": { "type": "object", "minProperties": 5, "additionalProperties": { "type": "string" } },
    "sources": { "type": "array", "minItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url", "supports"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "supports": { "type": "string" } } } }
  },
  "$defs": {
    "answers": { "type": "object", "additionalProperties": false, "required": ["phenomenon", "transport", "arrival", "impact", "conclusion"], "properties": { "phenomenon": { "type": "string" }, "transport": { "type": "string" }, "arrival": { "type": "string" }, "impact": { "type": "string" }, "conclusion": { "type": "string" } } },
    "choices": { "type": "object", "additionalProperties": false, "required": ["phenomenon", "transport", "arrival", "impact", "conclusion"], "properties": { "phenomenon": { "$ref": "#/$defs/choiceArray" }, "transport": { "$ref": "#/$defs/choiceArray" }, "arrival": { "$ref": "#/$defs/choiceArray" }, "impact": { "$ref": "#/$defs/choiceArray" }, "conclusion": { "$ref": "#/$defs/choiceArray" } } },
    "choiceArray": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "category", "headline", "challenge", "observations", "choices", "answers"], "properties": { "id": { "type": "string", "pattern": "^SA-[0-9]{2}$" }, "category": { "enum": ["indicator", "radiation", "particles", "plasma", "combined"] }, "headline": { "type": "string" }, "challenge": { "type": "string" }, "observations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }, "choices": { "$ref": "#/$defs/choices" }, "answers": { "$ref": "#/$defs/answers" } } }
  }
}
