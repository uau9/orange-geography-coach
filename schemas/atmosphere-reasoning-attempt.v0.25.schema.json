{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/atmosphere-reasoning-attempt.v0.25.schema.json",
  "title": "大气运动连续推理作答记录 v0.25",
  "type": "object",
  "required": ["schema_version", "id", "lab_id", "scenario_id", "section_id", "contrast_key", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": {"const": "0.25.0"},
    "id": {"type": "string"},
    "lab_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "section_id": {"type": "string"},
    "contrast_key": {"type": "string"},
    "answers": {"type": "object"},
    "correct_answers": {"type": "object"},
    "checks": {"type": "object"},
    "score": {"type": "integer", "minimum": 0, "maximum": 5},
    "error_tags": {"type": "array", "items": {"type": "string"}},
    "reasoning": {"type": "string"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "parent_review_status": {"enum": ["待家长确认", "已确认", "需再练", "需教师复核"]},
    "parent_note": {"type": "string"}
  }
}
