{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/recall-cards.v1.schema.json",
  "title": "高中地理挖空背诵卡 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "source", "interaction", "audit", "chapters", "lessons"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "edition", "page_count", "arrangement"],
      "properties": {
        "title": { "type": "string" },
        "edition": { "type": "string" },
        "page_count": { "const": 74 },
        "arrangement": { "type": "string" }
      }
    },
    "interaction": { "type": "object" },
    "audit": {
      "type": "object",
      "required": ["method", "status", "lesson_count", "supplemented_lesson_count", "corrected_lesson_count"]
    },
    "chapters": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "lesson_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^recall-chapter-[1-5]$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "lesson_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^recall-[0-9]{2}$" } }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "chapter", "title", "source_pages", "question_pages", "answer_segments", "supplement", "corrections"],
        "properties": {
          "id": { "type": "string", "pattern": "^recall-[0-9]{2}$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 25 },
          "chapter": { "type": "string" },
          "title": { "type": "string" },
          "source_pages": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "maximum": 74 } }
          },
          "question_pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page_number", "image", "width", "height", "crop_bottom", "blanks"],
              "properties": {
                "page_number": { "type": "integer", "minimum": 1, "maximum": 74 },
                "image": { "type": "string", "pattern": "^\\./assets/recall/geography-basics-26/page-[0-9]{3}\\.jpg$" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "crop_bottom": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "blanks": { "type": "array", "items": { "$ref": "#/$defs/blank" } }
              }
            }
          },
          "answer_segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page_number", "image", "crop_top", "crop_bottom"],
              "properties": {
                "page_number": { "type": "integer", "minimum": 1, "maximum": 74 },
                "image": { "type": "string" },
                "crop_top": { "type": "number", "minimum": 0, "maximum": 1 },
                "crop_bottom": { "const": 1 }
              }
            }
          },
          "supplement": {
            "type": ["object", "null"],
            "properties": { "label": { "type": "string" }, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
            "required": ["label", "items"]
          },
          "corrections": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "blank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "number", "answer", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^recall-[0-9]{2}-p[0-9]{3}-b[0-9]{3}$" },
        "answer": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["line", "table", "diagram"] },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "number": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
