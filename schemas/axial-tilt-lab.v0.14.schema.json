{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/axial-tilt-lab.v0.14.schema.json",
  "title": "黄赤交角与五带实验数据 v0.14",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_id", "title", "description", "model_note", "review_after_hours", "facts", "scenarios", "choices", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.14.0" },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "model_note": { "type": "string", "minLength": 1 },
    "review_after_hours": { "type": "integer", "minimum": 24 },
    "facts": { "type": "object", "additionalProperties": false, "required": ["current_tilt_deg", "max_model_tilt_deg", "tropic_formula", "polar_circle_formula", "tropical_width_formula", "temperate_width_formula"], "properties": {
      "current_tilt_deg": { "const": 23.5 }, "max_model_tilt_deg": { "const": 45 },
      "tropic_formula": { "type": "string" }, "polar_circle_formula": { "type": "string" }, "tropical_width_formula": { "type": "string" }, "temperate_width_formula": { "type": "string" }
    } },
    "scenarios": { "type": "array", "minItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "target_tilt_deg"], "properties": {
      "id": { "type": "string", "pattern": "^AT-[0-9]{2}$" }, "target_tilt_deg": { "type": "number", "minimum": 0, "maximum": 45 }
    } } },
    "choices": { "type": "object", "required": ["zone_change"] },
    "error_tags": { "type": "object", "minProperties": 5 },
    "sources": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["title", "publisher", "url", "used_for"] } }
  }
}
