{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/solar-activity-attempt.v0.17.schema.json",
  "title": "太阳活动证据判读实验记录 v0.17",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "scenario_id", "category", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": { "const": "0.17.0" }, "id": { "type": "string" }, "scenario_id": { "type": "string", "pattern": "^SA-[0-9]{2}$" }, "category": { "enum": ["indicator", "radiation", "particles", "plasma", "combined"] },
    "answers": { "$ref": "#/$defs/answers" }, "correct_answers": { "$ref": "#/$defs/answers" },
    "checks": { "type": "object", "additionalProperties": false, "required": ["phenomenon", "transport", "arrival", "impact", "conclusion"], "properties": { "phenomenon": { "type": "boolean" }, "transport": { "type": "boolean" }, "arrival": { "type": "boolean" }, "impact": { "type": "boolean" }, "conclusion": { "type": "boolean" } } },
    "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "error_tags": { "type": "array", "items": { "type": "string" } }, "reasoning": { "type": "string" }, "submitted_at": { "type": "string", "format": "date-time" }, "parent_review_status": { "enum": ["待家长确认", "已确认", "需再练", "需教师复核"] }, "parent_note": { "type": "string" }
  },
  "$defs": { "answers": { "type": "object", "additionalProperties": false, "required": ["phenomenon", "transport", "arrival", "impact", "conclusion"], "properties": { "phenomenon": { "type": "string" }, "transport": { "type": "string" }, "arrival": { "type": "string" }, "impact": { "type": "string" }, "conclusion": { "type": "string" } } } }
}
