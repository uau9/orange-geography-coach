{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange-geography-coach/earth-motion-attempt.v0.5",
  "title": "晨昏线实验作答记录 v0.5",
  "type": "object",
  "required": ["schema_version", "id", "view_id", "point_id", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status"],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "id": {"type": "string", "pattern": "^ATT-"},
    "view_id": {"enum": ["north", "south", "equator"]},
    "point_id": {"enum": ["upper", "lower", "visible"]},
    "answers": {"type": "object"},
    "correct_answers": {"type": "object"},
    "checks": {"type": "object"},
    "score": {"type": "integer", "minimum": 0, "maximum": 4},
    "error_tags": {"type": "array", "items": {"enum": ["E-SUN-SIDE", "E-VIEW-ROTATION", "E-TERM-TRANSITION", "E-TERM-NAME"]}},
    "reasoning": {"type": "string"},
    "submitted_at": {"type": "string"},
    "parent_review_status": {"enum": ["待家长确认", "已确认", "需再练", "需教师复核"]},
    "parent_note": {"type": "string"}
  },
  "additionalProperties": false
}
