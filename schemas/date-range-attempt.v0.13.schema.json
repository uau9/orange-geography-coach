{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/date-range-attempt.v0.13.schema.json",
  "title": "全球日期范围实验记录 v0.13",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "scenario_id", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": { "const": "0.13.0" },
    "id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "pattern": "^DR-[0-9]{2}$" },
    "answers": { "type": "object", "additionalProperties": false, "required": ["zero_meridian", "new_date_percent", "old_date_percent", "date_count", "crossing_result"], "properties": {
      "zero_meridian": { "type": "number", "minimum": -180, "maximum": 180 },
      "new_date_percent": { "type": "number", "minimum": 0, "maximum": 100 },
      "old_date_percent": { "type": "number", "minimum": 0, "maximum": 100 },
      "date_count": { "type": "string" },
      "crossing_result": { "type": "string" }
    } },
    "correct_answers": { "type": "object" },
    "checks": { "type": "object" },
    "score": { "type": "integer", "minimum": 0, "maximum": 5 },
    "error_tags": { "type": "array", "items": { "type": "string" } },
    "reasoning": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "parent_review_status": { "enum": ["待家长确认", "已确认", "需再练", "需教师复核"] },
    "parent_note": { "type": "string" }
  }
}
