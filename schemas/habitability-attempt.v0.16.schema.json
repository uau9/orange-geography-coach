{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/habitability-attempt.v0.16.schema.json",
  "title": "地球宜居条件对照实验记录 v0.16",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "scenario_id", "pair_category", "answers", "correct_answers", "checks", "score", "error_tags", "reasoning", "submitted_at", "parent_review_status", "parent_note"],
  "properties": {
    "schema_version": { "const": "0.16.0" }, "id": { "type": "string", "minLength": 1 }, "scenario_id": { "type": "string", "pattern": "^HB-[0-9]{2}$" }, "pair_category": { "enum": ["same_solar", "different_solar"] },
    "answers": { "$ref": "#/$defs/answers" }, "correct_answers": { "$ref": "#/$defs/answers" },
    "checks": { "type": "object", "additionalProperties": false, "required": ["higher_solar", "higher_pressure", "temperature_window", "stable_liquid_water", "best_inference"], "properties": { "higher_solar": { "type": "boolean" }, "higher_pressure": { "type": "boolean" }, "temperature_window": { "type": "boolean" }, "stable_liquid_water": { "type": "boolean" }, "best_inference": { "type": "boolean" } } },
    "score": { "type": "integer", "minimum": 0, "maximum": 5 }, "error_tags": { "type": "array", "items": { "type": "string" } }, "reasoning": { "type": "string" }, "submitted_at": { "type": "string", "format": "date-time" }, "parent_review_status": { "enum": ["待家长确认", "已确认", "需再练", "需教师复核"] }, "parent_note": { "type": "string" }
  },
  "$defs": { "answers": { "type": "object", "additionalProperties": false, "required": ["higher_solar", "higher_pressure", "temperature_window", "stable_liquid_water", "best_inference"], "properties": { "higher_solar": { "type": "string" }, "higher_pressure": { "type": "string" }, "temperature_window": { "type": "string" }, "stable_liquid_water": { "type": "string" }, "best_inference": { "type": "string" } } } }
}
