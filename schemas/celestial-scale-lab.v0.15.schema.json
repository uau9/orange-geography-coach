{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/celestial-scale-lab.v0.15.schema.json",
  "title": "天体系统尺度实验数据 v0.15",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "topic_id", "title", "review_after_hours", "model_note", "levels", "choices", "scenarios", "answers", "error_tags", "sources"],
  "properties": {
    "schema_version": { "const": "0.15.0" },
    "id": { "const": "celestial-scale-lab" },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "review_after_hours": { "type": "integer", "minimum": 24 },
    "model_note": { "type": "string", "minLength": 1 },
    "levels": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["id", "order", "name", "short_name", "location", "scale_anchor", "unit", "object_note"], "properties": {
      "id": { "enum": ["earth-moon", "solar-system", "milky-way", "observable-universe"] }, "order": { "type": "integer", "minimum": 0, "maximum": 3 }, "name": { "type": "string" }, "short_name": { "type": "string" }, "location": { "type": "string" }, "scale_anchor": { "type": "string" }, "unit": { "type": "string" }, "object_note": { "type": "string" }
    } } },
    "choices": { "type": "object", "additionalProperties": false, "required": ["system_order", "moon_distance", "earth_sun_unit", "galactic_location", "diagram_rule"], "properties": {
      "system_order": { "$ref": "#/$defs/choices" }, "moon_distance": { "$ref": "#/$defs/choices" }, "earth_sun_unit": { "$ref": "#/$defs/choices" }, "galactic_location": { "$ref": "#/$defs/choices" }, "diagram_rule": { "$ref": "#/$defs/choices" }
    } },
    "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "target_level_id", "challenge"], "properties": {
      "id": { "type": "string", "pattern": "^CS-[0-9]{2}$" }, "target_level_id": { "enum": ["earth-moon", "solar-system", "milky-way", "observable-universe"] }, "challenge": { "type": "string", "minLength": 1 }
    } } },
    "answers": { "type": "object", "additionalProperties": false, "required": ["system_order", "moon_distance", "earth_sun_unit", "galactic_location", "diagram_rule"], "properties": {
      "system_order": { "type": "string" }, "moon_distance": { "type": "string" }, "earth_sun_unit": { "type": "string" }, "galactic_location": { "type": "string" }, "diagram_rule": { "type": "string" }
    } },
    "error_tags": { "type": "object", "minProperties": 5 },
    "sources": { "type": "array", "minItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["title", "url", "supports"], "properties": { "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "supports": { "type": "string" } } } }
  },
  "$defs": { "choices": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } } }
}
