{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/date-range-lab.v0.13.schema.json",
  "title": "全球日期范围实验数据 v0.13",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_id", "title", "description", "model_note", "review_after_hours", "scenarios", "choices", "error_tags"],
  "properties": {
    "schema_version": { "const": "0.13.0" },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "model_note": { "type": "string", "minLength": 1 },
    "review_after_hours": { "type": "integer", "minimum": 24 },
    "scenarios": { "type": "array", "minItems": 8, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "utc_minutes", "crossing_direction"],
      "properties": {
        "id": { "type": "string", "pattern": "^DR-[0-9]{2}$" },
        "utc_minutes": { "type": "integer", "minimum": 0, "maximum": 1439 },
        "crossing_direction": { "enum": ["向东越过180°经线", "向西越过180°经线"] }
      }
    } },
    "choices": { "type": "object", "additionalProperties": false, "required": ["date_count", "crossing_result"], "properties": {
      "date_count": { "type": "array", "minItems": 3, "items": { "type": "string" } },
      "crossing_result": { "type": "array", "minItems": 3, "items": { "type": "string" } }
    } },
    "error_tags": { "type": "object", "minProperties": 5 }
  }
}
