{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uau9.github.io/orange-geography-coach/schemas/learning-export.v0.10.schema.json",
  "title": "橙子地理教练可批注学习档案 v0.10",
  "type": "object",
  "required": ["version", "export_schema_version", "export_id", "exported_at", "exported_at_local", "timezone", "summary", "attempts", "retest_attempts", "time_lab_attempts", "earth_motion_attempts", "solar_season_attempts", "solar_path_attempts", "annual_sun_attempts", "orbit_speed_attempts", "coach_annotations", "annotation_guide"],
  "properties": {
    "version": { "enum": ["0.1.0", "0.2.0", "0.3.0"] },
    "export_schema_version": { "const": "0.10.0" },
    "export_id": { "type": "string", "pattern": "^EXPORT-" },
    "exported_at": { "type": "string", "format": "date-time" },
    "exported_at_local": { "type": "string", "minLength": 20 },
    "timezone": { "type": "string", "minLength": 1 },
    "app_version": { "const": "0.10.0" },
    "student_alias": { "type": "string" },
    "privacy_note": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["total_learning_records", "pending_parent_reviews", "activity_window", "by_project", "by_topic", "candidate_error_tags"],
      "properties": {
        "total_learning_records": { "type": "integer", "minimum": 0 },
        "pending_parent_reviews": { "type": "integer", "minimum": 0 },
        "activity_window": { "type": "object" },
        "by_project": { "type": "array", "minItems": 8 },
        "by_topic": { "type": "array" },
        "candidate_error_tags": { "type": "array" }
      }
    },
    "attempts": { "type": "array" },
    "retest_attempts": { "type": "array" },
    "time_lab_attempts": { "type": "array" },
    "earth_motion_attempts": { "type": "array" },
    "solar_season_attempts": { "type": "array" },
    "solar_path_attempts": { "type": "array" },
    "annual_sun_attempts": { "type": "array" },
    "orbit_speed_attempts": { "type": "array" },
    "coach_annotations": { "type": "array" },
    "annotation_guide": { "type": "object", "required": ["purpose", "principles", "expected_annotation_shape"] }
  }
}
